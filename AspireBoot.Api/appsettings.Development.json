{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "JasperFx": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Wolverine": "Warning"
    }
  },
  "AllowedHosts": "api.localhost;localhost",
  "AspireBoot": {
    "Api": {
      "Frontend": {
        "Origin": "https://app.localhost"
      },
      "RateLimiters": {
        "Auth": {
          "PermitLimit": 60,
          "WindowInMinutes": 1
        },
        "Reads": {
          "PermitLimit": 60,
          "WindowInMinutes": 1
        },
        "Writes": {
          "PermitLimit": 60,
          "WindowInMinutes": 1
        }
      },
      "ReverseProxy": {
        "IpNetwork": "127.0.0.1/32"
      }
    },
    "Core": {
      "EmailRequests": {
        "CooldownInSeconds": 60,
        "PermitLimit": 10,
        "WindowInMinutes": 60
      }
    },
    "Infrastructure": {
      "Database": {
        "ApplyMigrationsOnStartup": true
      },
      "DataProtection": {
        "CertificatePassword": "aspireboot",
        "CertificatePath": "certs/data-protection.pfx"
      },
      "Messaging": {
        "AutoProvision": true,
        "Bindings": [
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.audit",
            "RoutingKey": "identity.users.audit"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.change-email",
            "RoutingKey": "identity.auth.change-email"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.confirm-email",
            "RoutingKey": "identity.auth.confirm-email"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.password-changed",
            "RoutingKey": "identity.auth.password-changed"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.request-recovery",
            "RoutingKey": "identity.auth.request-recovery"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.send-email-confirmation",
            "RoutingKey": "identity.auth.send-email-confirmation"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.create-session",
            "RoutingKey": "identity.sessions.create-session"
          },
          {
            "Exchange": "aspireboot.events",
            "Queue": "aspireboot.worker.email.delete-user",
            "RoutingKey": "identity.users.delete-user"
          }
        ],
        "ConsumerDispatchConcurrency": 1,
        "EventRoutes": {
          "identity.users.audit": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.users.audit"
          },
          "identity.auth.change-email": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.auth.change-email"
          },
          "identity.auth.confirm-email": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.auth.confirm-email"
          },
          "identity.auth.password-changed": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.auth.password-changed"
          },
          "identity.auth.request-recovery": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.auth.request-recovery"
          },
          "identity.auth.send-email-confirmation": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.auth.send-email-confirmation"
          },
          "identity.sessions.create-session": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.sessions.create-session"
          },
          "identity.users.delete-user": {
            "Exchange": "aspireboot.events",
            "RoutingKey": "identity.users.delete-user"
          }
        },
        "Exchanges": {
          "aspireboot.events": {
            "AutoDelete": false,
            "IsDurable": true,
            "Type": "topic"
          }
        },
        "InboxRetentionDays": 7,
        "PrefetchCount": 10,
        "Queues": {
          "aspireboot.worker.audit": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.change-email": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.confirm-email": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.password-changed": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.request-recovery": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.send-email-confirmation": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.create-session": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          },
          "aspireboot.worker.email.delete-user": {
            "AutoDelete": false,
            "ConsumerEnabled": true,
            "IsDurable": true,
            "IsExclusive": false,
            "QueueType": "quorum"
          }
        }
      },
      "ObjectStorage": {
        "AccessKey": "aspireboot",
        "BucketName": "aspireboot",
        "CreateBucketIfMissing": true,
        "Endpoint": "http://localhost:9000",
        "PublicEndpoint": "https://rustfs-api.localhost",
        "ReadinessPath": "/health",
        "Region": "us-east-1",
        "SecretKey": "aspireboot",
        "UrlExpiresInDays": 7
      },
      "Smtp": {
        "From": "noreply@aspireboot.localhost",
        "Host": "localhost",
        "Password": "aspireboot",
        "Port": 587,
        "StartTls": false,
        "Username": "aspireboot"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=aspireboot;Username=aspireboot;Password=aspireboot;Search Path=public",
    "Rabbit": "amqp://aspireboot:aspireboot@localhost:5672",
    "Redis": "localhost:6379,abortConnect=false"
  }
}
